# Copy to .env for local overrides. In production these are set on Render.

NODE_ENV=production
PORT=4000
# Public origin, used in SMS links and M-Pesa callback URLs (Render sets RENDER_EXTERNAL_URL if this is empty)
PUBLIC_URL=https://mjengo-oclock.onrender.com

# Supabase session pooler, as the mjengo_api role (schema "mjengo" in the Fpesa project)
DATABASE_URL=postgresql://mjengo_api.mrsxvdxaoogamhkdqejp:<password>@aws-0-eu-central-1.pooler.supabase.com:5432/postgres

# 32+ random characters each
JWT_SECRET=
# 32 bytes as 64 hex characters: encrypts admin authenticator secrets and national ID numbers
MASTER_KEY=
# Signs the short-lived links to private photos (defaults to JWT_SECRET)
MEDIA_SIGNING_KEY=
# Lets the first admin be created at /admin while none exists
ADMIN_SETUP_TOKEN=

# M-Pesa (Daraja). "simulated" confirms every prompt by itself and moves no money.
MPESA_DRIVER=simulated
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
# Set for a Buy Goods till instead of a Paybill
MPESA_TILL=
# Secret path segment on the callback URL: PUBLIC_URL/api/mpesa/callback/<token>
MPESA_CALLBACK_TOKEN=
# B2C for worker payouts and refunds. Without it they wait in Admin › Payouts for the finance team.
MPESA_B2C_SHORTCODE=
MPESA_B2C_INITIATOR=
MPESA_B2C_SECURITY_CREDENTIAL=
MPESA_B2C_COMMAND=BusinessPayment

# Celcom Africa bulk SMS (isms.celcomafrica.com). Without these, texts are only written to the log.
CELCOM_API_KEY=
CELCOM_PARTNER_ID=
# The registered sender ID
CELCOM_SHORTCODE=
# Show sign-in codes on screen. Only for testing without SMS; refused once Celcom is configured.
OTP_ECHO=off

# Mapbox: server token for geocoding and drive-time ETAs; public token (URL-restricted) for map tiles.
# Without them: Photon (OpenStreetMap) search, a distance-based ETA and OpenStreetMap tiles.
MAPBOX_TOKEN=
MAPBOX_PUBLIC_TOKEN=
